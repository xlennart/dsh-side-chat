{
  "name": "dsh-side-chat",
  "version": "1.2.1",
  "description": "DeepSeek Harness 原生并排侧聊：归档独立会话、按需主会话上下文、原生会话 UI 与可配置生命周期。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarlOfLaw/dsh-side-chat.git"
  },
  "bugs": {
    "url": "https://github.com/KarlOfLaw/dsh-side-chat/issues"
  },
  "homepage": "https://github.com/KarlOfLaw/dsh-side-chat#readme",
  "type": "module",
  "main": "./dist/formal-host.mjs",
  "files": [
    "dist/formal-host.mjs",
    "dist/formal-client.cjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:formal": "node build-formal.mjs",
    "prepare": "node build.mjs",
    "test": "node build.mjs && node tests/core.test.mjs && node tests/integration.test.mjs && node tests/client-contract.test.mjs && node tests/native-conversation.test.mjs && node tests/smoke.test.mjs",
    "check": "node build.mjs && node tests/core.test.mjs && node tests/integration.test.mjs && node tests/client-contract.test.mjs && node tests/native-conversation.test.mjs && node tests/smoke.test.mjs"
  },
  "exports": {
    ".": "./dist/formal-host.mjs",
    "./client": "./dist/formal-client.cjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.7-rc.2 <0.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.24.1 <0.25.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
